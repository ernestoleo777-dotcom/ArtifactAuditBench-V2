{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "predicted_errors", "overall_status", "repair_suggestions",
    "execution_status", "latency_seconds", "input_tokens", "output_tokens",
    "estimated_cost", "model", "prompt_version"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^v2_[0-9a-f]{16}$"},
    "predicted_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error_type", "affected_artifact", "affected_elements",
          "reported_values", "expected_values", "evidence", "confidence"
        ],
        "properties": {
          "error_type": {
            "enum": [
              "numeric_copy_error", "relative_improvement_error", "ranking_error",
              "legend_swap", "metric_name_mismatch", "axis_scale_error",
              "error_bar_error", "series_data_swap", "aggregation_error",
              "significance_overclaim", "ablation_conclusion_error",
              "selective_reporting", "clean", "unknown"
            ]
          },
          "affected_artifact": {"type": "string"},
          "affected_elements": {"type": "array", "items": {"type": "string"}},
          "reported_values": {"type": "object"},
          "expected_values": {"type": "object"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "overall_status": {"enum": ["clean", "error", "unknown"]},
    "repair_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["affected_artifact", "affected_elements", "suggested_action"],
        "properties": {
          "affected_artifact": {"type": "string"},
          "affected_elements": {"type": "array", "items": {"type": "string"}},
          "suggested_action": {"type": "string"}
        }
      }
    },
    "execution_status": {"enum": ["success", "failed"]},
    "latency_seconds": {"type": "number", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost": {"type": "number", "minimum": 0},
    "model": {"type": "string", "minLength": 1},
    "prompt_version": {"const": "direct_mllm_v1"}
  }
}
